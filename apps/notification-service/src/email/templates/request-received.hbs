<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>Request Received</title>
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }
      body {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        background-color: #f5f5f5;
      }
      .email-wrapper {
        max-width: 600px;
        margin: 40px auto;
        background: #fff;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
      }
      .email-header {
        background: linear-gradient(135deg, #0d7377, #14a085);
        padding: 40px 30px;
        text-align: center;
      }
      .email-header h1 {
        color: #fff;
        font-size: 24px;
        margin-bottom: 8px;
      }
      .email-header p {
        color: rgba(255, 255, 255, 0.85);
        font-size: 14px;
      }
      .email-body {
        padding: 40px 30px;
      }
      .email-body p {
        font-size: 15px;
        line-height: 1.7;
        color: #555;
        margin-bottom: 14px;
      }
      .request-type-badge {
        display: inline-block;
        background: #e8f5f5;
        color: #0d7377;
        padding: 6px 16px;
        border-radius: 20px;
        font-size: 14px;
        font-weight: 600;
        margin-bottom: 24px;
      }
      .info-table {
        width: 100%;
        border-collapse: collapse;
        margin: 20px 0;
      }
      .info-table th {
        background: #f9f9f9;
        padding: 10px 14px;
        text-align: left;
        font-size: 12px;
        color: #999;
        text-transform: uppercase;
        width: 40%;
      }
      .info-table td {
        padding: 10px 14px;
        font-size: 14px;
        color: #333;
        border-bottom: 1px solid #f5f5f5;
      }
      .ref-box {
        background: #f0fafa;
        border: 2px dashed #0d7377;
        border-radius: 8px;
        padding: 16px;
        text-align: center;
        margin: 20px 0;
      }
      .ref-box p {
        margin: 0;
      }
      .ref-box .ref-number {
        font-size: 20px;
        font-weight: 700;
        color: #0d7377;
        letter-spacing: 2px;
      }
      .ref-box .ref-label {
        font-size: 12px;
        color: #999;
        margin-top: 4px;
      }
      .email-footer {
        background: #2d2d2d;
        padding: 30px;
        text-align: center;
      }
      .email-footer p {
        color: #999;
        font-size: 13px;
        line-height: 1.6;
      }
      .email-footer a {
        color: #0d7377;
        text-decoration: none;
      }
    </style>
  </head>
  <body>
    <div class='email-wrapper'>

      <div class='email-header'>
        <h1>📨 Request Received</h1>
        <p>Freminatos Charity Organization</p>
      </div>

      <div class='email-body'>
        <p>Dear <strong>{{fullName}}</strong>,</p>

        <p>
          Thank you for reaching out to Freminatos Charity Organization. We have
          successfully received your request and our team will get back to you
          as soon as possible.
        </p>

        <span class='request-type-badge'>📋 {{requestType}}</span>

        <table class='info-table'>
          <tr>
            <th>Name</th>
            <td>{{fullName}}</td>
          </tr>
          <tr>
            <th>Email</th>
            <td>{{email}}</td>
          </tr>
          <tr>
            <th>Request Type</th>
            <td>{{requestType}}</td>
          </tr>
          <tr>
            <th>Submitted On</th>
            <td>{{submittedAt}}</td>
          </tr>
          <tr>
            <th>Status</th>
            <td>⏳ Pending Review</td>
          </tr>
        </table>

        <div class='ref-box'>
          <p class='ref-label'>Your Reference ID</p>
          <p class='ref-number'>{{referenceId}}</p>
          <p class='ref-label'>Keep this ID for future correspondence</p>
        </div>

        <p>
          Our team typically responds within
          <strong>2-3 business days</strong>. You will receive an email
          notification when your request has been reviewed.
        </p>

        <p>
          If you need to follow up, please email us at
          <a
            href='mailto:info@freminatos.org'
            style='color: #0D7377;'
          >info@freminatos.org</a>
          and include your reference ID above.
        </p>

        <p>
          Thank you for your interest in supporting our mission. Every inquiry
          brings us closer to our goal of restoring lives and rebuilding hope in
          Tigray.
        </p>

        <p>
          Warmly,<br />
          <strong>The Freminatos Team</strong>
          🌿
        </p>
      </div>

      <div class='email-footer'>
        <p>
          <strong style='color: #fff;'>Freminatos Charity Organization</strong>
        </p>
        <p>Mekelle, Tigray, Ethiopia</p>
        <p style='margin-top: 12px;'>
          <a href='{{appUrl}}'>freminatos.org</a>
          ·
          <a href='mailto:info@freminatos.org'>info@freminatos.org</a>
        </p>
      </div>

    </div>
  </body>
</html>